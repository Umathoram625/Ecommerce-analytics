# ==============================================================================
# E-COMMERCE SALES ANALYTICS CONFIGURATION
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development
PROJECT_NAME="E-Commerce Sales Analytics API"
VERSION="1.0.0"

# Network & Server
HOST=0.0.0.0
PORT=8000

# Database URL
# For local SQLite: sqlite:///./data/database/superstore.db
# For PostgreSQL (e.g., Render or local): postgresql://user:password@localhost:5432/ecommerce_sales
DATABASE_URL=sqlite:///./data/database/superstore.db

# CORS Allowed Origins (Comma separated or *)
CORS_ORIGINS=*

# Ingestion settings
MAX_UPLOAD_SIZE_MB=50
